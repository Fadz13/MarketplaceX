# =============================================================================
# MARKETPLACEX — ENVIRONMENT VARIABLES TEMPLATE
# This file is safe to commit. It documents required variables without values.
# Copy to .env.local and fill in your real credentials.
# =============================================================================

# Supabase — Public
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — Server only (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# Application
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_NAME=MarketplaceX

# Midtrans — Sandbox
# Server-only: used for Snap API calls and webhook signature verification.
# NEVER expose this to the browser (no NEXT_PUBLIC_ prefix).
MIDTRANS_SERVER_KEY=

# Public: used by Snap.js in the browser to initialize the payment popup.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=

# Set to "true" only when switching to Midtrans production environment.
MIDTRANS_IS_PRODUCTION=false
